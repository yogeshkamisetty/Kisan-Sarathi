# ============================================================================
# KISANSAATHI — FASAL AWAAZ ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and fill in credentials. Never commit real secrets to Git!
# ============================================================================

NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000

# --- Primary Relational Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://fasal_user:fasal_dev_pass_change_me@localhost:5432/fasal_awaaz?schema=public

# --- Background Job Queue (Redis 7) ---
REDIS_URL=redis://localhost:6379

# --- Durable State ---
# Domain state is written through to JSON files under DATA_DIR so an API restart never
# destroys a farmer draft mid-deadline. Set PERSISTENCE=memory to disable (tests only).
PERSISTENCE=file
DATA_DIR=.data

# --- Authentication & Token Security ---
JWT_ACCESS_SECRET=replace_with_32_byte_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_32_byte_random_hex_refresh_secret
# Server-side provisioning of privileged roles. A request body can NEVER grant these.
# Format: comma-separated mobile:ROLE pairs, e.g. 9876543210:CSC_OPERATOR,9811111111:ADMIN
PRIVILEGED_USERS=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Gnani AI Speech APIs (Verified Vachana Platform Endpoints) ---
# Generate API key from https://docs.gnani.ai / Gnani Dashboard
# Sent via HTTP header: X-API-Key-ID
# If omitted in development, adapters automatically report mode=MOCK_DEVELOPMENT
GNANI_API_KEY=
GNANI_STT_BASE_URL=https://api.vachana.ai
GNANI_TTS_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5

# --- Optional Server-Side Schema-Constrained Extraction LLM ---
# Deterministic extractor runs by default; Gemini assists when configured
GEMINI_API_KEY=

# --- S3-Compatible Object Storage (MinIO in Development / S3 in Production) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=fasal-awaaz-artifacts
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin_change_me

# --- OTP Provider Configuration ---
# Set ENABLE_DEV_MOCK_OTP=false in production!
OTP_PROVIDER_API_KEY=
ENABLE_DEV_MOCK_OTP=true

# --- Hackathon Demo Seed Endpoint ---
# POST /api/v1/demo/run is disabled unless this is exactly "true", and always
# disabled when NODE_ENV=production.
ENABLE_DEMO_ENDPOINT=false

# --- Mobile Client (safe to ship in the app bundle) ---
# Backend origin the Android app calls. Never put GNANI_API_KEY or JWT secrets here.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
